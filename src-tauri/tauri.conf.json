{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uClipboard",
  "version": "0.1.0",
  "identifier": "com.uclipboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "uClipboard",
        "width": 880,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; img-src 'self' data: asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'",
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNkI3RkJDRDZCMDY3ODQKUldTRVo3RFd2SDlyTXlneG1ReUEvN3YvbXVhd1BZemVMazlXSmR3MzBKbG5XdTd2ZTZGUTBORS8K",
      "endpoints": [
        "https://github.com/pigstrong9/uClipboard/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": false,
    "shortDescription": "跨平台开源剪贴板管理器",
    "longDescription": "uClipboard 自动记录文本、图片和文件剪贴板历史，支持搜索、收藏、置顶、全局快捷键和临时中转。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
